alert tcp any any -> $HOME_NET any (msg:"SYNTRA - Possible SYN Flood"; flags:S; flow:stateless; detection_filter:track by_dst,count 30,seconds 5; classtype:attempted-dos; sid:1000002; rev:1;)

alert icmp any any -> $HOME_NET any (msg:"SYNTRA - Possible ICMP Flood"; itype:8; detection_filter:track by_src,count 20,seconds 5; classtype:attempted-dos; sid:1000003; rev:1;)

alert tcp any any -> $HOME_NET any (msg:"SYNTRA - Possible TCP Scan Activity"; flags:S; flow:stateless; detection_filter:track by_src,count 15,seconds 10; classtype:network-scan; sid:1000004; rev:1;)

